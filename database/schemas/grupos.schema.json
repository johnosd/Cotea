{
  "bsonType": "object",
  "properties": {
    "_id": { "bsonType": "objectId" },
    "nome": { "bsonType": "string" },
    "slug": { "bsonType": "string" },
    "capa": { "bsonType": "string" },
    "imageUrl": { "bsonType": "string" },
    "imageKey": { "bsonType": "string" },
    "valorTotal": { "bsonType": "number" },
    "valorPorVaga": { "bsonType": "number" },
    "repassePorVaga": { "bsonType": "number" },
    "taxaPorVaga": { "bsonType": "number" },
    "precoValido": { "bsonType": "bool" },
    "descricao": { "bsonType": "string" },
    "capacidadeTotal": { "bsonType": "number" },
    "vagasReservadasAdmin": { "bsonType": "number" },
    "vagasDisponiveis": { "bsonType": "number" },
    "servicoPreAssinado": { "bsonType": "bool" },
    "envioAutomaticoAcesso": { "bsonType": "bool" },
    "filaEsperaAtiva": { "bsonType": "bool" },
    "necessitaAnalise": { "bsonType": "bool" },
    "observacoesInternas": { "bsonType": "string" },
    "subtitulo": { "bsonType": "string" },
    "acesso": { "bsonType": "string" },
    "tempoEntrega": { "bsonType": "string" },
    "confiabilidade": { "bsonType": "string" },
    "categoria": { "bsonType": "string" },
    "tipoGrupo": { "bsonType": "string" },
    "status": {
      "bsonType": "string",
      "description": "Estado de moderação (005-aprovacao-grupos): em_aprovacao | ajustes | rejeitado | ativo (aprovado e público) | cancelado. Ausente = ativo (legado)."
    },
    "statusDetalhado": { "bsonType": "string" },
    "versaoParticipacao": {
      "bsonType": "number",
      "description": "Trava de concorrência das participações (006-checkout-caucao): $inc em toda entrada e saída."
    },
    "lotadoEm": {
      "bsonType": "date",
      "description": "Só em grupo apos_completar: quando lotou pela primeira vez (006); depois disso não há mensalidade retida."
    },
    "beneficios": {
      "bsonType": "array",
      "items": { "bsonType": "string" }
    },
    "fidelidade": {
      "bsonType": "object",
      "properties": {
        "periodoMeses": { "bsonType": "number" },
        "renovacaoAutomatica": { "bsonType": "bool" },
        "observacoes": { "bsonType": "string" },
        "proximaRenovacao": { "bsonType": "null" }
      }
    },
    "regras": {
      "bsonType": "array",
      "items": { "bsonType": "string" }
    },
    "faq": {
      "bsonType": "array",
      "items": {
        "bsonType": "object",
        "properties": {
          "pergunta": { "bsonType": "string" },
          "resposta": { "bsonType": "string" }
        }
      }
    },
    "linkOficial": { "bsonType": "string" },
    "createdAt": { "bsonType": "date" },
    "updatedAt": { "bsonType": "date" },
    "adminId": { "bsonType": "objectId" },
    "adminIdString": { "bsonType": "string" },
    "adminNome": { "bsonType": "string" },
    "adminEmail": { "bsonType": "string" },
    "adminAvatar": { "bsonType": "string" },
    "admin": {
      "bsonType": "object",
      "properties": {
        "userId": { "bsonType": "objectId" },
        "nome": { "bsonType": "string" },
        "email": { "bsonType": "string" },
        "avatar": { "bsonType": "string" }
      }
    },
    "participantesIds": { "bsonType": "array" },
    "moderacao": {
      "bsonType": "object",
      "description": "Moderação do grupo (005-aprovacao-grupos, data-model.md). Atualizar só por caminho pontuado via lib/moderacao-servidor.js.",
      "properties": {
        "envio": { "bsonType": "number", "description": "Nº do envio atual (1 na criação, +1 por reenvio, 0 = legado migrado)" },
        "enviadoEm": { "bsonType": ["date", "null"], "description": "Instante do envio atual; base do prazo de 2 dias úteis" },
        "revisaoPendente": { "bsonType": "bool", "description": "true após aprovação automática até a revisão; V2-11 retém o repasse enquanto true" },
        "aprovacao": {
          "bsonType": ["object", "null"],
          "properties": {
            "tipo": { "bsonType": "string", "description": "manual | automatica | legado" },
            "em": { "bsonType": "date" },
            "porId": { "bsonType": ["string", "null"] }
          }
        },
        "revisao": {
          "bsonType": ["object", "null"],
          "properties": {
            "porId": { "bsonType": ["string", "null"] },
            "em": { "bsonType": "date" },
            "resultado": { "bsonType": "string", "description": "confirmada | reprovada" }
          }
        },
        "ultimaDecisao": {
          "bsonType": ["object", "null"],
          "properties": {
            "acao": { "bsonType": "string" },
            "texto": { "bsonType": ["string", "null"] },
            "porId": { "bsonType": ["string", "null"] },
            "em": { "bsonType": "date" }
          }
        },
        "cancelamento": {
          "bsonType": ["object", "null"],
          "properties": {
            "origem": { "bsonType": "string", "description": "dono | cotea" },
            "motivo": { "bsonType": ["string", "null"] },
            "porId": { "bsonType": ["string", "null"] },
            "em": { "bsonType": "date" }
          }
        },
        "historico": {
          "bsonType": "array",
          "description": "Append-only, no máximo 100 eventos ($slice: -100)",
          "items": {
            "bsonType": "object",
            "properties": {
              "acao": { "bsonType": "string" },
              "de": { "bsonType": ["string", "null"] },
              "para": { "bsonType": "string" },
              "texto": { "bsonType": ["string", "null"] },
              "porId": { "bsonType": ["string", "null"] },
              "automatico": { "bsonType": "bool" },
              "envio": { "bsonType": "number" },
              "em": { "bsonType": "date" }
            }
          }
        }
      }
    }
  }
}
